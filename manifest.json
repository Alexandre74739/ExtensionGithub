{
  "manifest_version": 3,
  "name": "GitHub Ctrl+P → Profil",
  "version": "1.0.0",
  "description": "Sur github.com, Ctrl+P ouvre ton profil GitHub.",
  "browser_specific_settings": {
    "gecko": {
      "id": "github-ctrlp-profil@perez.local",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
